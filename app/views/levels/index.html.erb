<section class="hero-panel">
  <div class="hero-copy">
    <div class="hero-tag">Ruby Quest</div>
    <h1>Impara Ruby costruendo dungeon</h1>
    <p>I costrutti Ruby si sbloccano come abilità del golem, non come capitoli di un manuale.</p>

    <div class="hero-buttons">
      <%= link_to "Concept", "#", class: "hero-pill active" %>
      <%= link_to "Mappa live", "#", class: "hero-pill" %>
      <%= link_to "Schemata puzzle", "#", class: "hero-pill" %>
      <%= link_to "Progressione Ruby", "#", class: "hero-pill" %>
    </div>
  </div>

  <div class="hero-status-card">
    <div class="status-top">
      <span class="status-level">Lv</span>
      <span class="status-number">3</span>
    </div>
    <div class="status-xp">480 XP</div>
  </div>
</section>

<section class="roadmap-grid">
  <article class="roadmap-card roadmap-card--green">
    <div class="roadmap-header">Piano 1</div>
    <h2>Le Fondamenta</h2>
    <ul>
      <li class="completed">variabili & tipi</li>
      <li class="completed">if / else / end</li>
      <li class="completed">Array, Hash</li>
      <li class="in-progress">.each, .map</li>
      <li>metodi</li>
    </ul>
    <%= link_to "Gioca Piano 1", level_path(1), class: "nav-button" %>
  </article>

  <article class="roadmap-card roadmap-card--blue">
    <div class="roadmap-header">Piano 2</div>
    <h2>Classi e Oggetti</h2>
    <ul>
      <li>class Golem</li>
      <li>initialize</li>
      <li>ereditarietà</li>
      <li>attr_reader</li>
      <li>moduli</li>
    </ul>
    <%= link_to "Gioca Piano 2", level_path(2), class: "nav-button" %>
  </article>

  <article class="roadmap-card roadmap-card--purple">
    <div class="roadmap-header">Piano 3</div>
    <h2>Blocchi e Proc</h2>
    <ul>
      <li>blocchi { |x| }</li>
      <li>Proc e Lambda</li>
      <li>yield</li>
      <li>map, select, reduce</li>
    </ul>
    <%= link_to "Gioca Piano 3", level_path(3), class: "nav-button" %>
  </article>

  <article class="roadmap-card roadmap-card--amber">
    <div class="roadmap-header">Piano 4</div>
    <h2>Gestione Errori</h2>
    <ul>
      <li>begin / rescue</li>
      <li>raise</li>
      <li>ensure</li>
      <li>eccezioni custom</li>
    </ul>
    <%= link_to "Gioca Piano 4", level_path(4), class: "nav-button" %>
  </article>
</section>

<section class="levels-section">
  <h2 style="margin-top: 2rem; margin-bottom: 1.5rem;">Livelli Disponibili</h2>
  <div class="levels-grid">
    <% @levels.each do |level| %>
      <div class="level-card">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
          <h3><%= level.title %></h3>
          <% progress = level.user_progresses.find_by(user: current_user) %>
          <% if progress&.completed? %>
            <span style="background: rgba(76, 175, 80, 0.2); color: #4caf50; padding: 0.25rem 0.5rem; border-radius: 999px; font-size: 0.7rem; font-weight: bold;">✓</span>
          <% end %>
        </div>
        <p><%= level.description %></p>
        <div class="level-type">
          <span class="type-badge"><%= level.level_type %></span>
        </div>
        <%= link_to "Gioca", level_path(level), class: "nav-button" %>
      </div>
    <% end %>
  </div>
</section>

<section class="final-card">
  <div>
    <div class="final-label">Piano 5 — Boss finale: il Golem Autonomo</div>
    <p>Il giocatore scrive un programma Ruby completo che fa sopravvivere il golem a una sequenza di nemici con comportamenti diversi. È il progetto finale del gioco.</p>
  </div>
  <%= link_to "Implementa drag-and-drop in Gosu", levels_path, class: "final-button" %>
</section>
